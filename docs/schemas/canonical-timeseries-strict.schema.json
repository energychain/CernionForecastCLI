{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energychain.github.io/CernionForecastCLI/schemas/canonical-timeseries-strict.schema.json",
  "title": "Cernion Forecast Canonical Time Series — Productive Contract",
  "type": "object",
  "required": ["tenant_id", "series_id", "series_type", "measurement_semantics", "unit", "timezone", "values"],
  "additionalProperties": false,
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1},
    "series_id": {"type": "string", "minLength": 1},
    "series_type": {"enum": ["meter", "portfolio", "aggregate", "synthetic"]},
    "measurement_semantics": {"enum": ["consumption", "generation", "net_load", "feed_in", "price", "weather_context"]},
    "value_semantics": {"enum": ["interval_energy", "average_power"]},
    "unit": {"enum": ["kWh", "kW"]},
    "timezone": {"type": "string", "minLength": 1},
    "period_from": {"type": "string", "format": "date"},
    "period_until": {"type": "string", "format": "date"},
    "source": {"type": "object"},
    "source_envelope": {"type": "object"},
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp", "event_time", "available_at", "value", "value_version"],
        "additionalProperties": false,
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "event_time": {"type": "string", "format": "date-time"},
          "available_at": {"type": "string", "format": "date-time"},
          "ingested_at": {"type": "string", "format": "date-time"},
          "value_version": {"type": "string", "minLength": 1},
          "revision": {"type": ["integer", "string"]},
          "value": {"type": "number"},
          "quality": {"type": "string"}
        }
      }
    }
  }
}
