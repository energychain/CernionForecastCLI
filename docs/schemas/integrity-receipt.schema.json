{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energychain.github.io/CernionForecastCLI/schemas/integrity-receipt.schema.json",
  "title": "Cernion Forecast Integrity Evidence Receipt",
  "type": "object",
  "required": ["contract_id", "receipt_schema_version", "status", "operation", "created_at", "created_by", "gates", "links", "receipt_hash"],
  "additionalProperties": true,
  "properties": {
    "contract_id": {"const": "CET-FC-DIC-001"},
    "receipt_schema_version": {"const": "cernion.forecast.integrity-receipt.v1"},
    "status": {"enum": ["pass", "fail", "rejected"]},
    "operation": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string"},
    "tenant_id": {"type": ["string", "null"]},
    "series_id": {"type": ["string", "null"]},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "information_cutoff": {"type": ["string", "null"], "format": "date-time"},
    "integrity_decision": {"enum": ["ACCEPTED", "PROVISIONAL", "REJECTED"]},
    "integrity_decision_detail": {
      "type": "object",
      "properties": {"availability_evidence": {"enum": ["VERIFIED", "ASSUMED", "UNVERIFIABLE"]}}
    },
    "forecast_acceptance_decision": {"enum": ["ACCEPTED", "REJECTED", null]},
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {"status": {"enum": ["pass", "fail", "ok", "warning"]}, "required": {"type": "boolean"}}
      }
    },
    "artifacts": {"type": "object"},
    "links": {"type": "object"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
