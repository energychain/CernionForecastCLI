{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energychain.github.io/CernionForecastCLI/schemas/validation-error.schema.json",
  "title": "Cernion Forecast Validation Error",
  "type": "object",
  "required": ["code", "message", "status"],
  "additionalProperties": true,
  "properties": {
    "status": {"enum": ["REJECTED", "FAILED", "WARNING"]},
    "code": {"type": "string", "pattern": "^(INV|GATE|AT|ERR)-[0-9A-Z_-]+$"},
    "message": {"type": "string", "minLength": 1},
    "contract_id": {"const": "CET-FC-DIC-001"},
    "field": {"type": "string"},
    "timestamp": {"type": "string"},
    "available_at": {"type": "string"},
    "retryable": {"type": "boolean"}
  }
}
